{$CADDY_DOMAIN} {
	encode zstd gzip

	@monitor path /monitor /monitor/*
	handle @monitor {
		basic_auth {
			{$MONITOR_USER} {$MONITOR_PASSWORD_HASH}
		}
		reverse_proxy server:2568
	}

	handle /healthz {
		reverse_proxy server:2568
	}

	# Colyseus matchmaking and room WebSockets must reach the authoritative server.
	handle /matchmake/* {
		reverse_proxy server:2568
	}

	handle /room/* {
		reverse_proxy server:2568
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
