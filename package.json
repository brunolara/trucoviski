{
  "name": "trucoviski2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "arena": "tsx scripts/arena.mts",
    "league": "tsx scripts/league.mts",
    "sweep:v3": "tsx scripts/sweep-v3.mts",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "pnpm format:check && pnpm lint && pnpm types && pnpm test && pnpm sim:heuristic && pnpm build",
    "lint": "eslint .",
    "sim": "tsx scripts/sim.mts",
    "sim:heuristic": "tsx scripts/sim-heuristic.mts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "types": "turbo run typecheck",
    "validate:compose": "docker compose config --quiet"
  },
  "devDependencies": {
    "@colyseus/testing": "0.17.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@trucoviski/engine": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "10.7.0",
    "fast-check": "^4.9.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tsx": "^4.23.1",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
