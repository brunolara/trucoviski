# Copy this file to .env on the VPS. Never commit the resulting .env file; chmod it 600.
# Generate a strong MONITOR_PASSWORD on the VPS and never display it.
# /monitor is accessible only through an SSH tunnel.
# Do not use or create an Apache htpasswd file for /monitor.
HOST_BIND_PORT=2568
MONITOR_USER=admin
MONITOR_PASSWORD=

# Persistent SQLite location inside the server's named data volume.
SQLITE_PATH=/data/trucoviski.sqlite
