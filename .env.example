# Copy to .env on the VPS. Never commit the resulting .env file.
# DNS for DOMAIN must point to this VPS before first deployment.
DOMAIN=truco.example.com

# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'use-a-long-unique-password'
MONITOR_USER=admin
MONITOR_PASSWORD_HASH='$2a$14$replace-with-a-caddy-bcrypt-hash'

# Persistent SQLite location inside the server's named data volume.
SQLITE_PATH=/data/trucoviski.sqlite
